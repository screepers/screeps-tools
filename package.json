{
    "name": "screeps-tools",
    "version": "3.0.0",
    "description": "Tools to help players of the Programming MMO Screeps",
    "keywords": [
        "screeps",
        "react",
        "typescript"
    ],
    "homepage": "https://screepers.github.com/screeps-tools",
    "bugs": "https://github.com/screepers/screeps-tools/issues",
    "license": "MIT",
    "author": "Xilexio",
